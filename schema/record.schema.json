{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://significance.dev/schema/record.schema.json",
  "title": "Significance claim record",
  "description": "Structural schema for a Significance v0.1 claim record. This schema validates shape and attribution only; it does not and cannot determine mathematical truth. Cross-record rules (uniqueness, append-only history, foreign-key resolution of asserted_by, freshness staleness computation) are enforced by `significance validate`, not by this schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_version",
    "record_state",
    "freshness",
    "parties",
    "claim",
    "manuscript",
    "evidence",
    "ai_provenance",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema generation this record conforms to. v0.1 only emits 1."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[a-z0-9]+){2,}$",
      "description": "Globally namespaced as <year>-<author-slug>-<topic-slug>, lowercase kebab-case, e.g. '2026-sandoval-ramsey-k7'. Uniqueness is enforced per-repository by the validator, not by this schema."
    },
    "record_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic integer. The validator enforces monotonic increase against the base-branch record; this schema only enforces type and lower bound."
    },
    "record_state": {
      "type": "string",
      "enum": ["active", "superseded", "withdrawn"],
      "description": "Authored lifecycle state. Distinct from freshness, which is computed."
    },
    "draft": {
      "type": "boolean",
      "description": "True only for a non-public editorial working draft. Drafts are not canonical records and must render an explicit warning."
    },
    "freshness": { "$ref": "#/$defs/freshness" },
    "parties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/party" },
      "propertyNames": { "$ref": "#/$defs/party_id" },
      "description": "Map of party id to identity. Every asserted_by elsewhere in the record must reference a key declared here (enforced by the validator, not this schema)."
    },
    "claim": { "$ref": "#/$defs/claim" },
    "author_relationship": { "$ref": "#/$defs/author_relationship" },
    "plain_summary": { "$ref": "#/$defs/plain_summary" },
    "review_map": { "$ref": "#/$defs/review_map" },
    "accurate_wording": { "$ref": "#/$defs/accurate_wording" },
    "manuscript": { "$ref": "#/$defs/manuscript" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_item" }
    },
    "ai_provenance": { "$ref": "#/$defs/ai_provenance" },
    "digestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/digestion" }
    },
    "importance_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/importance_claim" }
    },
    "open_invitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/open_invitation" }
    },
    "attestations": {
      "type": "array",
      "items": { "$ref": "#/$defs/attestation" }
    },
    "depends_on": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/history_event" },
      "description": "Append-only. Existing event ids may never disappear or change payload; the validator enforces this against the base-branch record, this schema only validates shape of the current set."
    }
  },

  "$defs": {
    "basis": {
      "type": "string",
      "enum": ["source_quote", "author_attestation", "editorial_inference", "machine_result"]
    },
    "digest_basis": {
      "description": "Basis values permitted for a plain-language restatement. A digest asserts no new fact: it restates material already present in this record, in fewer and plainer words, and is attributable to whoever wrote the restatement. It is deliberately a separate enum rather than a new member of `basis`, so that nothing carrying evidentiary weight — a correspondence claim, an execution receipt, a claim text — can ever be asserted on the strength of a restatement.",
      "type": "string",
      "enum": ["digest", "editorial_inference"]
    },
    "attested_basis": {
      "description": "Basis values permitted for claims of correspondence between formal and informal statements. Correspondence is attested, never machine-asserted.",
      "type": "string",
      "enum": ["source_quote", "author_attestation", "editorial_inference"]
    },
    "party_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "iso_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_method"],
      "oneOf": [
        { "required": ["name"] },
        { "required": ["pseudonym"] }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pseudonym": { "type": "string", "minLength": 1 },
        "affiliation": { "type": "string", "maxLength": 200 },
        "affiliation_basis": { "type": "string", "const": "self_declared" },
        "verification_method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["github_identity", "orcid", "email_confirmation", "pseudonymous", "automation"]
            },
            "identifier": { "type": "string" },
            "verified_at": { "$ref": "#/$defs/iso_datetime" }
          }
        }
      }
    },

    "attributed_value": {
      "description": "Base shape shared by every non-trivial asserted value in the record: no unattributed assertion.",
      "type": "object",
      "required": ["value", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "value": {},
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },

    "locator": {
      "description": "Pointer to where an attributed value comes from in the source. Required whenever basis is source_quote (enforced by the validator).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "quote": { "type": "string" }
      }
    },

    "execution_receipt": {
      "description": "Required for any machine_result. A bare result: passed with no receipt is rejected by the validator; this schema requires the fields to be present at all.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "runner_image_digest", "executed_at", "result", "log_sha256", "asserted_by"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "runner_image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "executed_at": { "$ref": "#/$defs/iso_datetime" },
        "result": { "type": "string", "enum": ["passed", "failed"] },
        "log_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "asserted_by": { "$ref": "#/$defs/party_id" }
      }
    },

    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "checked_at"],
      "properties": {
        "result": { "type": "string", "enum": ["current", "stale", "unknown"] },
        "observed_source_version": { "type": "string" },
        "confirmed_source_version": { "type": "string" },
        "checked_at": { "$ref": "#/$defs/iso_datetime" }
      },
      "if": {
        "properties": { "result": { "const": "unknown" } },
        "required": ["result"]
      },
      "then": {},
      "else": {
        "required": ["result", "checked_at", "observed_source_version", "confirmed_source_version"]
      }
    },

    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "scope"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "text": { "$ref": "#/$defs/attributed_value" },
        "display_math": {
          "description": "Optional LaTeX presentation of the claim text. Converted to MathML by the renderer; it does not replace the attributed plain-text claim.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": { "$ref": "#/$defs/attributed_value" },
        "exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributed_value" }
        }
      }
    },

    "author_relationship": {
      "description": "How, if at all, the manuscript author participated in this Significance record. This describes the record-making relationship only; it is never evidence for the mathematics.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["public_sources_only", "author_confirmed_description", "author_contributed", "author_requested"]
        },
        "note": { "type": "string", "minLength": 1 },
        "basis": {
          "type": "string",
          "enum": ["author_attestation", "editorial_inference"]
        },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "public_sources_only" } },
            "required": ["status"]
          },
          "then": { "properties": { "basis": { "const": "editorial_inference" } } },
          "else": {
            "required": ["locator"],
            "properties": { "basis": { "const": "author_attestation" } }
          }
        }
      ]
    },
    "attestations": {
      "type": "array",
      "items": { "$ref": "#/$defs/attestation" }
    },
    "depends_on": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },

    "accurate_wording": {
      "description": "One sentence somebody writing about this claim can use without overstating it. It exists because overstatement is mostly a symptom of precise language being work: a journalist, blogger or forum poster on a deadline takes the nearest available phrasing, and this hands them a better one. It is a suggestion and never a requirement — this project does not tell anyone what to write — and it is the field most likely to drift into a verdict and the field where a verdict would travel furthest, since it is written to be pasted. The validator holds it to the same lint as every other plain-language block.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/digest_basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },

    "plain_summary": {
      "description": "A four-question plain-words restatement for a reader who does not know this project's vocabulary: what is claimed, what has been checked, what has not been checked, and as of when. It is optional, it is signed like everything else, and it is a digest — it may restate what the record already says and may never add to it. The word caps and the refusal of verdict language are enforced by `significance validate`, not by this schema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed", "checked", "not_checked", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "claimed": { "type": "string", "minLength": 1 },
        "checked": {
          "type": "string",
          "minLength": 1,
          "description": "A plain restatement of the strongest evidence in this record. Not a judgement about whether the claim is right — the strongest evidence a record holds may still be 'reported, not reproduced'."
        },
        "not_checked": {
          "type": "string",
          "minLength": 1,
          "description": "A plain restatement of what remains open: the record's open invitations and the gaps its evidence entries name. Required rather than optional, because a summary that lists only what was checked reads as an endorsement."
        },
        "basis": { "$ref": "#/$defs/digest_basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" },
        "translations": {
          "type": "array",
          "items": { "$ref": "#/$defs/plain_summary_translation" },
          "description": "The same four questions in another language. A translation is a second summary with its own asserter, not a presentation setting on the first: whoever translated it is answerable for it, and a record that renders a sentence in Arabic has somebody's name against that sentence."
        }
      }
    },

    "plain_summary_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lang", "claimed", "checked", "not_checked", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$",
          "description": "BCP 47 language tag. Rendered into the lang attribute, so a screen reader pronounces the block in the right language rather than reading French as mangled English."
        },
        "claimed": { "type": "string", "minLength": 1 },
        "checked": { "type": "string", "minLength": 1 },
        "not_checked": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/digest_basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" }
      }
    },

    "review_map": {
      "description": "A reviewer-first map of where to begin. Each entry is attributed; this map directs reading and never asserts mathematical truth.",
      "type": "object",
      "additionalProperties": false,
      "required": ["main_deduction", "risks", "prerequisites"],
      "properties": {
        "main_deduction": { "$ref": "#/$defs/review_map_entry" },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/review_map_entry" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/review_map_entry" } },
        "needs_checking": { "type": "array", "items": { "$ref": "#/$defs/review_map_entry" } }
      }
    },

    "review_map_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "location": { "type": "string", "minLength": 1, "maxLength": 240 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
        "pointer": { "type": "string", "minLength": 1, "maxLength": 240 },
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },

    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "label", "sha256", "retrieved_at"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "minLength": 1 },
          "immutable_version_id": {
            "type": "string",
            "description": "Host-provided immutable version identifier where one exists, e.g. an arXiv vN. Compared before hashes, since a regenerated PDF can differ byte-for-byte without a meaningful revision."
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "retrieved_at": { "$ref": "#/$defs/iso_datetime" },
          "supplemental_artifacts": {
            "type": "array",
            "description": "Version-bound companion files published with the manuscript, such as an informal note or technical appendix. These are sources, not independent evidence entries.",
            "items": { "$ref": "#/$defs/source_artifact" }
          }
        }
      },

      "source_artifact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "label", "sha256", "retrieved_at"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "label": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "retrieved_at": { "$ref": "#/$defs/iso_datetime" }
        }
      },

    "axiom_trust_profile": {
      "type": "string",
      "enum": ["lean_standard_classical", "lean_standard_classical_plus_native", "custom"],
      "description": "Deliberately not named kernel_only. Each profile expands to a versioned allowlist that must appear in full in the receipt."
    },

    "axiom_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_profile", "allowlist", "allowlist_version", "execution"],
      "properties": {
        "trust_profile": { "$ref": "#/$defs/axiom_trust_profile" },
        "allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "allowlist_version": { "type": "string" },
        "execution": { "$ref": "#/$defs/execution_receipt" }
      }
    },

    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pin_kind", "pin"],
      "properties": {
        "name": { "type": "string" },
        "pin_kind": {
          "type": "string",
          "enum": ["digest", "commit"],
          "description": "Toolchain must be pinned by immutable digest or commit, never only a tag."
        },
        "pin": { "type": "string", "minLength": 1 }
      }
    },

    "evidence_item": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "kind": {
          "enum": [
            "formal_artifact", "external_formal_artifact",
            "computational_reproduction", "source_inspection", "informal_review", "mathematical_assessment"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "formal_artifact" } } },
          "then": { "$ref": "#/$defs/evidence_formal_artifact" }
        },
        {
          "if": { "properties": { "kind": { "const": "external_formal_artifact" } } },
          "then": { "$ref": "#/$defs/evidence_external_formal_artifact" }
        },
        {
          "if": { "properties": { "kind": { "const": "computational_reproduction" } } },
          "then": { "$ref": "#/$defs/evidence_computational_reproduction" }
        },
        {
          "if": { "properties": { "kind": { "const": "source_inspection" } } },
          "then": { "$ref": "#/$defs/evidence_source_inspection" }
        },
        {
          "if": { "properties": { "kind": { "const": "informal_review" } } },
          "then": { "$ref": "#/$defs/evidence_informal_review" }
        },
        {
          "if": { "properties": { "kind": { "const": "mathematical_assessment" } } },
          "then": { "$ref": "#/$defs/evidence_mathematical_assessment" }
        }
      ]
    },

    "evidence_formal_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "repo", "commit", "toolchain", "lockfile_hash", "artifact_build", "axiom_policy", "correspondence"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "formal_artifact" },
        "repo": { "type": "string", "format": "uri" },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Immutable commit sha, never a mutable tag or branch name."
        },
        "toolchain": { "$ref": "#/$defs/toolchain" },
        "lockfile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_build": { "$ref": "#/$defs/execution_receipt" },
        "axiom_policy": { "$ref": "#/$defs/axiom_policy" },
        "correspondence": {
          "allOf": [
            { "$ref": "#/$defs/attributed_value" },
            {
              "properties": {
                "basis": { "$ref": "#/$defs/attested_basis" }
              }
            }
          ]
        }
      }
    },

    "evidence_external_formal_artifact": {
      "description": "Reported, not reproduced: no receipts, no build claims.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "repo", "description", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "external_formal_artifact" },
        "repo": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "description": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },

    "evidence_computational_reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "execution"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "computational_reproduction" },
        "description": { "type": "string", "minLength": 1 },
        "inputs": { "type": "string" },
        "outputs_summary": { "type": "string" },
        "execution": { "$ref": "#/$defs/execution_receipt" }
      }
    },

    "evidence_source_inspection": {
      "description": "A bounded check that public sources, versions, hashes, and stated scope were located and transcribed. It is not a mathematical review.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "source_inspection" },
        "description": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },

    "evidence_informal_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reviewer", "text", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "informal_review" },
        "reviewer": { "$ref": "#/$defs/party_id" },
        "text": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },

    "evidence_mathematical_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target", "report", "basis", "asserted_by", "asserted_at"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "mathematical_assessment" },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Must name a specific numbered statement, e.g. 'Theorem 1.2', not the manuscript as a whole."
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "inline": { "type": "string" }
          }
        },
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" },
        "locator": { "$ref": "#/$defs/locator" },
        "author_response": {
          "type": "array",
          "description": "Attachable by the author; never removable by the assessor.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "asserted_by", "asserted_at"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "asserted_by": { "$ref": "#/$defs/party_id" },
              "asserted_at": { "$ref": "#/$defs/iso_datetime" }
            }
          }
        }
      }
    },

    "ai_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclosure", "roles"],
      "properties": {
        "disclosure": { "$ref": "#/$defs/attributed_value" },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "model", "basis", "asserted_by"],
            "description": "Roles are reported by a party, not independently discovered facts.",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "problem_selection", "literature_search", "conjecture_generation",
                  "proof_generation", "criticism", "computation", "formalization",
                  "prose_editing", "candidate_generation"
                ]
              },
              "model": { "type": "string", "minLength": 1 },
              "basis": { "$ref": "#/$defs/basis" },
              "asserted_by": { "$ref": "#/$defs/party_id" },
              "locator": { "$ref": "#/$defs/locator" }
            }
          }
        }
      }
    },

    "digestion_basis": {
      "description": "Basis values permitted for any digestion. The record-wide set plus `digest`, because every digestion is a restatement of material already in the record — that is what makes it a digestion rather than an evidence entry. A conditional below narrows this further for plain-language entries. Both this and the narrowing are needed: JSON Schema applies a property schema and its `then` branch together, so a base enum that excluded `digest` would refuse the value the conditional exists to permit.",
      "type": "string",
      "enum": ["source_quote", "author_attestation", "editorial_inference", "machine_result", "digest"]
    },

    "plain_language_basis": {
      "description": "Basis values permitted for a plain-language explanation. Everything except machine_result: a machine did not write an explanation for a human audience, and if one drafted it, the party publishing it is the one asserting it and their use of a model belongs in ai_provenance.",
      "type": "string",
      "enum": ["digest", "editorial_inference", "author_attestation", "source_quote"]
    },

    "stratum": {
      "description": "Which layer is speaking. Strata are always labeled and never blended: an author's explanation of their own result and an editor's explanation of it are different objects, rendered separately, even when they say the same thing.",
      "type": "string",
      "enum": ["author", "editor", "community"]
    },

    "digestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "text", "basis", "asserted_by", "source_claims"],
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["plain_language"],
          "description": "Absent for an ordinary digestion. `plain_language` marks an entry that explains what the result means, in words a non-specialist can follow — distinct from the plain_summary block, which reports status rather than meaning. The validator caps its length and refuses verdict language in it."
        },
        "stratum": { "$ref": "#/$defs/stratum" },
        "text": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/digestion_basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "locator": { "$ref": "#/$defs/locator" },
        "source_claims": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "if": {
        "properties": { "kind": { "const": "plain_language" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["stratum"],
        "properties": { "basis": { "$ref": "#/$defs/plain_language_basis" } }
      }
    },

    "importance_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "basis", "asserted_by"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/basis" },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "source": { "$ref": "#/$defs/locator" }
      }
    },

    "open_invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "created_by", "created_at"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "created_by": {
          "$ref": "#/$defs/party_id",
          "description": "Any named party, not restricted to authors."
        },
        "created_at": { "$ref": "#/$defs/iso_datetime" },
        "status": { "type": "string", "enum": ["open", "taken", "done", "withdrawn"], "default": "open" },
        "taken_by": { "type": "string", "minLength": 1 },
        "taken_at": { "$ref": "#/$defs/iso_datetime" },
        "taken_note": { "type": "string", "maxLength": 200 },
        "done_ref": { "type": "string", "minLength": 1 },
        "how": {
          "type": "string",
          "description": "What somebody would actually do: the exact commit, the toolchain, the command, the file to read. Optional, because an invitation whose instructions nobody has written down is still a real invitation — and rendering it with a 'take this task' button anyway would promise help that is not there. Non-emptiness is enforced by `significance validate`, which owns the rule so the failure has one name."
        },
        "respond": {
          "description": "Where the answer goes. At least one channel, because an invitation that says what to do and not where to say you did it is a dead end.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "mailto": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reviewer", "scope", "manuscript_sha256", "asserted_by", "asserted_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reviewer": { "$ref": "#/$defs/party_id" },
        "scope": { "type": "string", "minLength": 1 },
        "depth": { "type": "string", "minLength": 1 },
        "manuscript_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "review_note": { "type": "string", "maxLength": 1200 },
        "link": { "type": "string", "format": "uri" },
        "stratum": { "type": "string", "enum": ["author", "editor", "community", "domain_expert", "machine"] },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "asserted_at": { "$ref": "#/$defs/iso_datetime" }
      }
    },

    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "asserted_by", "basis"],
      "properties": {
        "record": { "$ref": "#/$defs/record_id_ref" },
        "external": {
          "type": "object", "additionalProperties": false, "required": ["label", "url"],
          "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" }, "version_hint": { "type": "string" } }
        },
        "relation": { "type": "string", "enum": ["cites", "builds_on", "uses_result"] },
        "asserted_by": { "$ref": "#/$defs/party_id" },
        "basis": { "type": "string", "enum": ["source_quote", "editor_note"] },
        "note": { "type": "string", "maxLength": 240 }
      },
      "oneOf": [{ "required": ["record"] }, { "required": ["external"] }]
    },

    "record_id_ref": { "type": "string", "pattern": "^[0-9]{4}(-[a-z0-9]+){2,}$" },

    "history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at", "by"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "type": "string", "minLength": 1 },
        "at": { "$ref": "#/$defs/iso_datetime" },
        "by": { "$ref": "#/$defs/party_id" },
        "note": { "type": "string" },
        "corrects": {
          "type": "string",
          "description": "References the id of an earlier event this one corrects. Corrections are new events; they never mutate the referenced event."
        }
      }
    }
  }
}
