{% extends "base.html.jinja" %}{% block title %}Reviewers — Significance{% endblock %}
{% block content %}<section class="band"><p class="lbl">Reviewers</p><p class="prose">Named people and identities with recorded work. This is a census, not a ranking.</p>{% if reviewers %}<ul class="records-index">{% for r in reviewers %}<li><a href="{{ r.id }}/index.html">{{ r.id|replace('-', ' ') }}</a><span class="meta">{{ r.records|length }} recorded entr{{ 'y' if r.records|length == 1 else 'ies' }}</span></li>{% endfor %}</ul>{% else %}<p class="prose">No named reviewer has recorded work yet.</p>{% endif %}</section>{% endblock %}
