{% extends "base.html.jinja" %}
{% block title %}Take this check — Significance{% endblock %}
{% block content %}
{% set task = row.invitation %}
<section class="band">
  <p class="lbl">Take this check</p>
  <h1 class="claim-text">{{ task.target }}</h1>
  <p class="meta"><a href="{{ row.record_href }}">{{ row.record.record_id }}</a> · task {{ row.task_id }}</p>
  <dl class="facts">
    <dt>Task type</dt><dd>{{ task.get('task_kind', task.get('kind', 'bounded check'))|replace('_', ' ') }}</dd>
    {% if task.get('entry_points') %}<dt>Entry points</dt><dd>{{ task.entry_points }}</dd>{% endif %}
    <dt>Source PDF</dt><dd><a class="button" href="{{ row.record.manuscript.url }}">Download the exact manuscript</a><br><span class="meta">{{ row.record.manuscript.label }} · version <code>{{ row.record.manuscript.sha256|short_hash }}</code></span></dd>
    {% set handoff = row.record.get('formalization_handoff', {}) %}
    {% if handoff.get('repository') %}<dt>Code</dt><dd><a href="{{ handoff.repository.url }}">Open the formalization repository</a>{% if handoff.repository.get('commit') %} · pinned commit <code>{{ handoff.repository.commit|short_hash }}</code>{% endif %}</dd>{% endif %}
    {% if task.get('effort_estimate') %}<dt>Effort</dt><dd>{{ task.effort_estimate }} <span class="meta">(estimated by {{ task.created_by }})</span></dd>{% endif %}
    {% if task.get('prerequisites') %}<dt>Prerequisites</dt><dd>{{ task.prerequisites|join('; ') }}</dd>{% endif %}
  </dl>
</section>
<section class="band"><p class="lbl">Status</p><p class="prose">{{ task.get('status', 'open')|capitalize }}{% if task.get('status') == 'taken' %} by {{ task.taken_by }} since {{ task.taken_at[:10] }}{% endif %}.</p></section>
<section class="band"><p class="lbl">How to do this</p><ol><li>Download the exact manuscript above and start with the stated entry points. The version hash identifies the file for the eventual record; you do not need to calculate it before reading.</li><li>Read or reproduce only the stated scope and note the method you actually used.</li>{% if row.issue_url %}<li>Submit what you found through the linked attestation form below, using the record, task, scope, and manuscript hash shown here. No Significance account is required; GitHub may ask you to sign in.</li>{% else %}<li>Copy the short template below into a pull request, or send it to the maintainer. No Significance account is required.</li>{% endif %}</ol>{% if row.issue_url %}<p><a class="button" href="{{ row.issue_url }}">Open attestation form</a></p>{% endif %}</section>
<section class="band"><p class="lbl">Attestation template</p><p class="prose">Fill only what you did. State what you checked and found—not whether the whole proof is correct.</p><pre class="copy-block">{{ row.attestation_yaml }}</pre></section>
{% endblock %}
