{% extends "base.html.jinja" %}
{% block title %}Take this check — Significance{% endblock %}
{% block content %}
{% set task = row.invitation %}
<section class="band">
  <p class="lbl">Take this check</p>
  <h1 class="claim-text">{{ task.target }}</h1>
  <p class="meta"><a href="{{ row.record_href }}">{{ row.record.record_id }}</a> · task {{ row.task_id }}</p>
  <dl class="facts">
    <dt>Task type</dt><dd>{{ task.get('task_kind', task.get('kind', 'bounded check'))|replace('_', ' ') }}</dd>
    {% if task.get('entry_points') %}<dt>Entry points</dt><dd>{{ task.entry_points }}</dd>{% endif %}
    <dt>Manuscript</dt><dd><a href="{{ row.record.manuscript.url }}">{{ row.record.manuscript.label }}</a> · <code>{{ row.record.manuscript.sha256|short_hash }}</code></dd>
    {% if task.get('effort_estimate') %}<dt>Effort</dt><dd>{{ task.effort_estimate }} <span class="meta">(estimated by {{ task.created_by }})</span></dd>{% endif %}
    {% if task.get('prerequisites') %}<dt>Prerequisites</dt><dd>{{ task.prerequisites|join('; ') }}</dd>{% endif %}
  </dl>
</section>
<section class="band"><p class="lbl">Status</p><p class="prose">{{ task.get('status', 'open')|capitalize }}{% if task.get('status') == 'taken' %} by {{ task.taken_by }} since {{ task.taken_at[:10] }}{% endif %}.</p></section>
<section class="band"><p class="lbl">How to do this</p><ol><li>Get the exact manuscript above and confirm its full SHA-256 hash is <code>{{ row.record.manuscript.sha256 }}</code>.</li><li>Read or reproduce only the stated scope and note the method you actually used.</li><li>Submit what you found through the pre-filled issue or propose the YAML below by pull request.</li></ol>{% if row.issue_url %}<p><a class="button" href="{{ row.issue_url }}">Open pre-filled attestation issue</a></p>{% endif %}</section>
<section class="band"><p class="lbl">Attestation template</p><p class="prose">Fill only what you did. State what you checked and found—not whether the whole proof is correct.</p><pre class="copy-block">{{ row.attestation_yaml }}</pre></section>
{% endblock %}
