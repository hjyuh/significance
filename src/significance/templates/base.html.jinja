<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none';">
<title>{% block title %}Significance{% endblock %}</title>
<link rel="stylesheet" href="{{ root_prefix }}static/style.css">
</head>
<body>
<header class="topline">
<a class="wordmark" href="{{ root_prefix }}index.html">SIGNIFICANCE</a>
<p class="topline-meta">{% block topline_meta %}Claim-state records for AI-assisted mathematics{% endblock %}</p>
</header>
<div class="shell{% block shell_class %}{% endblock %}">
<main>
{% block content %}{% endblock %}
</main>
{% block rail %}{% endblock %}
</div>
<footer class="site-footer">
<p>Significance mechanically validates provenance and a narrow set of evidence predicates. It does not mechanically determine mathematical truth.</p>
</footer>
</body>
</html>
