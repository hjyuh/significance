{% extends "base.html.jinja" %}
{% block title %}Significance — records{% endblock %}
{% block topline_meta %}{{ records|length }} record{{ '' if records|length == 1 else 's' }} · clear records for AI-assisted mathematics{% endblock %}

{% block content %}
<section class="band">
  <p class="lbl">Records</p>
  {% if records %}
  <ul class="records-index">
    {% for r in records %}
    <li>
      <div>
        <p class="record-claim"><a href="{{ r.record_id }}/index.html">{% if r.claim.get('display_math') %}<span class="claim-math-inline" aria-label="{{ r.claim.text.value }}">{{ r.claim.display_math|mathml }}</span>{% else %}{{ r.claim.text.value }}{% endif %}</a></p>
        {% set claimant = r.get('parties', {}).get(r.claim.text.get('asserted_by', ''), {}) %}
        {% set problem = r.get('problem_reference') %}
        <p class="record-id">{% if problem %}{{ problem.venue }} #{{ problem.problem_id }} · {% endif %}v{{ r.record_version }} · {% if claimant.get('name') %}{{ claimant.name }}{% elif claimant.get('pseudonym') %}{{ claimant.pseudonym }}{% else %}Claimant not named{% endif %}</p>
        <p class="record-actions"><a href="{{ r.record_id }}/index.html">Read the record</a> · <a href="{{ r.record_id }}/index.html#open-checks">See open checks</a></p>
      </div>
      <p class="record-state">
        <span>{% if r.get('draft') %}Editorial draft{% elif r.record_state == 'active' %}Active{% else %}{{ r.record_state|replace('_', ' ')|capitalize }}{% endif %}</span>
        {% set freshness = r.get('freshness', {}).get('result', 'unknown') %}
        <span>{% if freshness == 'current' %}Source current{% elif freshness == 'stale' %}Source changed{% else %}Source not rechecked{% endif %}</span>
        <span>{{ r.get('evidence', [])|length }} evidence · {{ r.get('open_invitations', [])|length }} open</span>
      </p>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="prose">No records built.</p>
  {% endif %}
</section>

<section class="band what-this-does-not-establish">
  <p class="lbl">What a record does not establish</p>
  <ul>
    <li>No field or rendered element asserts that a claim is verified, correct, or refuted.</li>
    <li>Evidence predicates are narrow: schema shape, attribution, execution receipts, append-only history.</li>
    <li>The publication state describes this page, never the standing of the mathematics.</li>
  </ul>
</section>
{% endblock %}
