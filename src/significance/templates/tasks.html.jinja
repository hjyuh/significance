{% extends "base.html.jinja" %}
{% block title %}Help check | Significance{% endblock %}
{% block topline_meta %}{{ rows|length }} bounded task{{ '' if rows|length == 1 else 's' }}{% endblock %}
{% block content %}
<section class="band">
  <p class="lbl">Help check a claim</p>
  <h1 class="claim-text">Find a claim. Choose one focused check.</h1>
  <p class="prose">Each task is scoped to a single passage or artifact. Reading needs no account; submitting through GitHub requires one.</p>
  {% if rows %}<p class="meta">{{ rows|length }} checks across {{ task_groups|length }} claims. Grouped by claim, with numbered problems in numerical order. Within each claim, open checks are arranged by category; checks already taken follow.</p>{% endif %}
</section>

{% set rewrite_rows = rows|selectattr('check_category', 'equalto', 'deslopping')|list %}
{% if rewrite_rows %}
<section class="band" id="deslopping">
  <p class="lbl">De-slopping / explanation rewrite</p>
  <p class="prose">Make a generated argument easier to read, with source references and explicit unresolved steps. These tasks follow the workflow described in <a href="https://github.com/GeorgeCoote/openai_372_deslop">George Coote’s repository</a>: distinguish an AI-assisted readable draft from a human-written rewrite. A rewrite does not establish mathematical correctness.</p>
  <ul>
  {% for row in rewrite_rows %}
    <li><a href="{{ row.task_href }}">{{ row.record.manuscript.label }} — {{ row.invitation.target }}</a></li>
  {% endfor %}
  </ul>
</section>
{% endif %}

{% if rows %}
<section class="band tasks-list">
  <nav class="task-jump-nav" id="task-top" aria-label="Jump to a claim">
    <p class="lbl">Jump to a claim</p>
    <ul>
    {% for group in task_groups %}
      <li><a href="#{{ group.anchor }}">{{ group.label|truncate(58) }} <span>({{ group.rows|length }})</span></a></li>
    {% endfor %}
    </ul>
  </nav>
{% for group in task_groups %}
  <section class="task-group" id="{{ group.anchor }}" aria-labelledby="{{ group.anchor }}-heading">
    <header class="task-group-header">
      <h2 id="{{ group.anchor }}-heading"><a href="{{ group.record_href }}">{{ group.label }}</a></h2>
      <p class="meta">{{ group.open_count }} open{% if group.taken_count %} · {{ group.taken_count }} taken{% endif %} · <a href="#task-top">Back to claims ↑</a></p>
      <p class="task-group-claim">{{ group.record.claim.text.value }}</p>
    </header>
  <ul class="task-cards">
{% for row in group.rows %}
{% set task = row.invitation %}
{% set task_type = task.get('task_kind', task.get('kind', 'bounded check'))|replace('_', ' ')|capitalize %}
{% set prerequisites = task.get('prerequisites') or [] %}
<li class="task-card">
  <a href="{{ row.task_href }}" class="task-card-link">
    <div class="task-card-header">
      <span class="task-status task-status-{{ task.get('status', 'open') }}">{{ task.get('status', 'open') }}</span>
    </div>
    <h3 class="task-card-title">{{ task.target }}</h3>
    <div class="task-card-meta">
      <span class="task-type">Type: {{ task_type }}</span>
      <span class="task-category">Check: {{ row.check_category_label }}</span>
      <span class="task-prereq">Prerequisites: {{ prerequisites|join('; ') if prerequisites else 'None listed' }}</span>
      <span class="task-effort">Effort: {{ task.get('effort_estimate')|configured or 'Not estimated' }}</span>
    </div>
  </a>
</li>
{% endfor %}
  </ul>
  </section>
{% endfor %}
</section>
{% else %}
<section class="band">
  <p class="prose">No tasks available right now.</p>
</section>
{% endif %}

{% if derived_rows %}
<section class="band">
  <details class="secondary-content">
    <summary>{{ derived_rows|length }} derived task{{ '' if derived_rows|length == 1 else 's' }} (records needing exposition)</summary>
    <p class="prose" >Derived by the build for records without exposition. An editor fills in details before inviting contributors.</p>
    <ul class="task-cards task-cards-derived">
    {% for row in derived_rows %}
    {% set task = row.invitation %}
    {% set problem = row.record.get('problem_reference') or {} %}
    {% set relationship = row.record.get('author_relationship') or {} %}
    {% set author_id = relationship.get('asserted_by') %}
    {% set author = row.record.get('parties', {}).get(author_id, {}) if author_id else {} %}
    {% set author_name = author.get('name', author.get('pseudonym')) %}
    {% set record_label = (problem.get('venue') ~ ' #' ~ problem.get('problem_id')) if problem.get('venue') and problem.get('problem_id') else (author_name or row.record.claim.text.value) %}
    {% set prerequisites = task.get('prerequisites') or [] %}
    <li class="task-card task-card-derived" id="{{ row.anchor }}">
      <div class="task-card-header">
        <span class="task-origin-derived">derived</span>
      </div>
      <h3 class="task-card-title">{{ row.record.claim.text.value|truncate(80) }}</h3>
      <p class="task-card-record"><a href="{{ row.record_href }}">{{ record_label }}</a></p>
      <div class="task-card-meta">
        <span class="task-type">Type: {{ task.get('task_kind', task.get('kind', 'bounded check'))|replace('_', ' ')|capitalize }}</span>
        <span class="task-category">Check: {{ row.check_category_label }}</span>
        <span class="task-prereq">Prerequisites: {{ prerequisites|join('; ') if prerequisites else 'None listed' }}</span>
        <span class="task-effort">Effort: {{ task.get('effort_estimate')|configured or 'Not estimated' }}</span>
      </div>
    </li>
    {% endfor %}
    </ul>
  </details>
</section>
{% endif %}
{% endblock %}
