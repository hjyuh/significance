{% extends "base.html.jinja" %}{% block title %}Backlog — Significance{% endblock %}
{% block content %}<section class="band"><p class="lbl">Backlog</p><p class="prose">Claims tracked here with the least recorded verification activity, oldest first. Absence of activity is not a judgment of the claim.</p><table><thead><tr><th>Claim</th><th>Filed</th><th>Last activity</th><th>Open</th><th>Taken</th><th>Named reviewers</th></tr></thead><tbody>{% for row in rows %}<tr><td><a href="{{ root_prefix }}{{ row.record.record_id }}/index.html">{{ row.record.claim.text.value }}</a></td><td>{{ row.record.manuscript.retrieved_at[:10] }}</td><td>{{ row.last }} · {{ row.days }} days ago</td><td>{{ row.open }}</td><td>{{ row.taken }}</td><td>{{ row.reviewers }}</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
