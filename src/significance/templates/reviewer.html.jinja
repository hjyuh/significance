{% extends "base.html.jinja" %}{% import "macros.jinja" as m %}{% block title %}{{ reviewer.display_name }} — reviewer page{% endblock %}
{% block content %}<section class="band"><p class="lbl">{{ reviewer.display_name }}</p>{% if reviewer.affiliation %}<p class="meta">Self-declared: {{ reviewer.affiliation }}</p>{% endif %}<p class="prose">{{ reviewer.records|length }} {{ 'entry' if reviewer.records|length == 1 else 'entries' }} across {{ reviewer.records|map(attribute='record.record_id')|unique|list|length }} {{ 'record' if reviewer.records|map(attribute='record.record_id')|unique|list|length == 1 else 'records' }}. No score or rank is assigned.</p>{% for item in reviewer.records %}{% set entry_id = item.entry.get('id', item.kind ~ '-' ~ loop.index) %}<article id="entry-{{ entry_id }}" class="evidence-card"><h3><a href="{{ root_prefix }}{{ item.record.record_id }}/index.html">{{ item.record.claim.text.value }}</a></h3><p class="meta">{{ item.kind|replace('_', ' ') }} · {{ item.entry.get('stratum', 'community') }} · scope: {{ item.entry.get('scope', item.entry.get('target', 'recorded work')) }}</p>{% if item.entry.get('review_note') %}<p>{{ item.entry.review_note }}</p>{% elif item.entry.get('text') %}<p>{{ item.entry.text }}</p>{% elif item.entry.get('taken_note') %}<p>{{ item.entry.taken_note }}</p>{% endif %}{% if item.kind == 'attestation' %}<p class="copy-block">{{ reviewer.display_name }}. Scoped check: {{ item.entry.get('scope', 'recorded work') }}. Significance record {{ item.record.record_id }}, manuscript {{ item.record.manuscript.sha256|short_hash }}, {{ item.entry.get('asserted_at', '')[:10] }}. {% if public_url %}{{ public_url.rstrip('/') }}/reviewers/{{ reviewer.id }}/#entry-{{ entry_id }}{% else %}reviewers/{{ reviewer.id }}/#entry-{{ entry_id }}{% endif %}</p>{% endif %}</article>{% endfor %}</section>{% endblock %}
