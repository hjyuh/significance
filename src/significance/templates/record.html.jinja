{% extends "base.html.jinja" %}
{% import "macros.jinja" as m %}

{% block title %}{{ record.record_id }} — Significance{% endblock %}
{% block shell_class %} with-rail{% endblock %}

{% set fr = record.get('freshness', {}) %}
{% set evidence = record.get('evidence', []) %}

{% block topline_meta %}Checked {{ fr.get('checked_at', '?')[:10] }} · source {% if fr.get('result') == 'current' %}current{% elif fr.get('result') == 'stale' %}changed{% else %}not rechecked{% endif %} · v{{ record.record_version }}{% endblock %}

{% block content %}
<article class="record">

  {% set ar = record.get('author_relationship') %}
  {% set formal_runs = evidence|selectattr('kind', 'equalto', 'formal_artifact')|list %}
  {% set computational_runs = evidence|selectattr('kind', 'equalto', 'computational_reproduction')|list %}
  {% set assessments = evidence|selectattr('kind', 'equalto', 'mathematical_assessment')|list %}
  {% set informal_reviews = evidence|selectattr('kind', 'equalto', 'informal_review')|list %}

  <header class="band record-hero">
    {% if record.get('draft') %}
    <div class="banner banner-unknown">
      <strong>Non-public editorial draft.</strong>
      The author has not approved publication of this record.
    </div>
    {% endif %}
    {% if fr.get('result') in ('stale', 'unknown') %}
    <div class="banner banner-{{ fr.result }}">
      <strong>{% if fr.result == 'stale' %}The source has changed since this page was checked.{% else %}This page has not yet been rechecked against the current source.{% endif %}</strong>
      Last checked {{ fr.get('checked_at', '?')[:10] }}.
    </div>
    {% endif %}
    {% set claimant_id = record.claim.text.get('asserted_by', '?') %}
    {% set claimant = record.get('parties', {}).get(claimant_id, {}) %}
    <p class="eyebrow">Claim from {{ claimant.get('name', claimant.get('pseudonym', m.party_label(claimant_id))) }}</p>
    {% if record.claim.get('display_math') %}
    <h1 class="claim-text claim-math" aria-label="{{ record.claim.text.value }}">{{ record.claim.display_math|mathml }}</h1>
    {% else %}
    <h1 class="claim-text">{{ record.claim.text.value }}</h1>
    {% endif %}
    <p class="claim-source">{{ m.attribution(record.claim.text) }}</p>
  </header>

  {% set problem = record.get('problem_reference') %}
  {% if problem %}
  <section class="band problem-reference" aria-labelledby="problem-reference-heading">
    <p class="lbl" id="problem-reference-heading">Problem link</p>
    <p class="problem-reference-value">{{ problem.venue }} #{{ problem.problem_id }} · {{ m.external_link(problem.url, 'open the original problem page') }}</p>
    <p class="meta">{{ m.attribution(problem) }}</p>
  </section>
  {% endif %}

  <section class="band record-relationship" aria-labelledby="relationship-heading">
    <p class="lbl" id="relationship-heading">Author involvement</p>
    {% if ar %}
    <p class="relationship-value">{{ ar.note }}</p>
    <p class="meta">{{ m.credit(ar, 'Record note') }}</p>
    {% else %}
    <p class="relationship-value">Compiled from public sources. No author participation in this Significance record is recorded.</p>
    <p class="meta">This describes the record-making relationship, not the mathematics.</p>
    {% endif %}
  </section>

  {% set ps = record.get('plain_summary') %}
  {% if ps %}
  {# First content block on the page, above the formal dossier, because the
     reader this is for stops reading before they reach the ledger. It is
     styled calm on purpose: no banner, no colour, nothing that could be read
     as a status light. The label names the writer, because an unsigned plain
     summary would read as the site speaking. #}
  <section class="band plain-summary" aria-labelledby="plain-summary-heading">
    <p class="lbl" id="plain-summary-heading">Summary · for readers</p>
    <dl class="plain-summary-list">
      <div>
        <dt>In one sentence</dt>
        <dd>{{ ps.claimed }}</dd>
      </div>
    </dl>
    <p class="meta">{{ m.credit(ps, 'Reader summary') }}</p>

    {% for tr in ps.get('translations', []) %}
    {# A translation is a second summary with its own asserter, so it renders
       as its own block with its own attribution rather than as a toggle on the
       first. lang and dir are set from the record, which is what lets a screen
       reader pronounce it correctly instead of reading French as broken
       English. #}
    {# dir is written as template markup, not as an expression returning an
       attribute string: autoescape turns the quotes in such a string into
       &#34; and the browser sees a broken attribute, so the Arabic block
       renders left-to-right while looking correct in the source. Caught by a
       test that asserted the rendered attribute rather than the intent. #}
    <div class="plain-summary-translation" lang="{{ tr.lang }}"{% if tr.lang.split('-')[0] in ('ar', 'fa', 'he', 'ur') %} dir="rtl"{% endif %}>
      <dl class="plain-summary-list">
        <div><dt>{{ m.term('claim', 'Claim', glossary, links) }}</dt><dd>{{ tr.claimed }}</dd></div>
        <div><dt>Checked</dt><dd>{{ tr.checked }}</dd></div>
        <div><dt>Not checked</dt><dd>{{ tr.not_checked }}</dd></div>
      </dl>
      <p class="meta" lang="en" dir="ltr">{{ m.attribution(tr) }} Translation into {{ tr.lang }}, attributed to its translator.</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% set review_map = record.get('review_map') %}
  {% if review_map %}
  <section class="band start-here" aria-labelledby="start-here-heading">
    <p class="lbl" id="start-here-heading">Start here · for reviewers</p>
    <div class="review-map-main">
      <p class="map-label">Main deduction</p>
      <p class="prose">{{ review_map.main_deduction.text }}</p>
      {% if review_map.main_deduction.location %}<p class="meta">{{ review_map.main_deduction.location }}{% if review_map.main_deduction.pointer %} · {{ review_map.main_deduction.pointer }}{% endif %} · {{ m.attribution(review_map.main_deduction) }}</p>{% endif %}
    </div>
    {% if review_map.risks %}
    <div class="review-map-group"><p class="map-label">Risk points</p><ul class="review-map-list">{% for item in review_map.risks %}<li><p class="prose">{{ item.text }}</p><p class="meta">{% if item.location %}{{ item.location }} · {% endif %}{{ m.attribution(item) }}</p></li>{% endfor %}</ul></div>
    {% endif %}
    {% if review_map.prerequisites %}
    <div class="review-map-group"><p class="map-label">Useful background</p><ul class="review-map-list">{% for item in review_map.prerequisites %}<li><p class="prose">{{ item.text }}</p><p class="meta">{% if item.pointer %}{{ item.pointer }} · {% endif %}{{ m.attribution(item) }}</p></li>{% endfor %}</ul></div>
    {% endif %}
    <div class="review-map-group"><p class="map-label">Needs checking</p><ul class="review-map-list">{% for item in review_map.needs_checking or [] %}<li><p class="prose">{{ item.text }}{% if item.reason %} <span class="meta">— {{ item.reason }}</span>{% endif %}</p><p class="meta">{% if item.location %}{{ item.location }} · {% endif %}{{ m.attribution(item) }}</p></li>{% endfor %}<li><a href="https://github.com/hjyuh/significance/issues/new?template=needs-checking.yml">Suggest another focused check</a></li></ul></div>
  </section>
  {% endif %}

  {% set handoff = record.get('formalization_handoff') %}
  {% if handoff %}
  <section class="band formalization-handoff" aria-labelledby="formalization-heading">
    <p class="lbl" id="formalization-heading">Formalization handoff</p>
    <p class="handoff-intro">A compact map for someone who wants to formalize this claim. It records preparation and open work, not a mathematical verdict.</p>
    <dl class="facts handoff-facts">
      <dt>Target</dt>
      <dd>{{ handoff.target.value }} {{ m.attribution(handoff.target) }}</dd>
      <dt>System</dt>
      <dd>{{ handoff.system.value }} {{ m.attribution(handoff.system) }}</dd>
      <dt>Work state</dt>
      <dd>{{ handoff.status|replace('_', ' ')|capitalize }}</dd>
      {% if handoff.get('repository') %}
      <dt>Code</dt>
      <dd>{{ m.external_link(handoff.repository.url, 'formalization repository') }}{% if handoff.repository.get('commit') %} · commit <code>{{ handoff.repository.commit|short_hash }}</code>{% endif %}{% if handoff.repository.get('toolchain') %}<span class="meta"> · {{ handoff.repository.toolchain }}</span>{% endif %}</dd>
      {% endif %}
    </dl>
    {% for label, items in [('Definitions', handoff.get('definitions', [])), ('Prerequisites', handoff.get('prerequisites', [])), ('Open questions', handoff.get('open_questions', []))] %}
    {% if items %}
    <div class="handoff-group"><p class="map-label">{{ label }}</p><ul class="review-map-list">{% for item in items %}<li><p class="prose">{{ item.value }}</p><p class="meta">{{ m.attribution(item) }}</p></li>{% endfor %}</ul></div>
    {% endif %}
    {% endfor %}
    {% if handoff.get('correspondence') %}<p class="meta"><strong>Paper/code correspondence:</strong> {{ handoff.correspondence.value }} {{ m.attribution(handoff.correspondence) }}</p>{% endif %}
    <p class="meta">{{ m.attribution(handoff) }}</p>
  </section>
  {% endif %}

  <section class="band review-coverage" aria-labelledby="coverage-heading">
    <p class="lbl" id="coverage-heading">Review activity</p>
    <dl class="coverage-list">
      <div><dt>Independent reruns</dt><dd>{{ formal_runs|length + computational_runs|length }}</dd></div>
      <div><dt>Math assessments</dt><dd>{{ assessments|length }}</dd></div>
      <div><dt>Written reviews</dt><dd>{{ informal_reviews|length }}</dd></div>
      <div><dt>Open checks</dt><dd>{{ record.get('open_invitations', [])|selectattr('status', 'undefined')|list|length + record.get('open_invitations', [])|selectattr('status', 'equalto', 'open')|list|length }}</dd></div>
    </dl>
    {% if ps %}
    <div class="coverage-notes">
      <p class="coverage-boundary"><strong>What Significance checked:</strong> {{ ps.checked }}</p>
      <p class="coverage-boundary"><strong>Still open:</strong> {{ ps.not_checked }}</p>
    </div>
    {% endif %}
  </section>

  {% set aw = record.get('accurate_wording') %}
  {% if aw %}
  {# The line written to be pasted into someone else's sentence. It sits with
     the strip because it answers the same reader's question, and it is marked
     a suggestion because this project does not tell anyone what to write. #}
  <section class="band accurate-wording">
    <p class="lbl">Careful wording</p>
    <p class="accurate-wording-value">{{ aw.value }}</p>
    <p class="meta">{{ m.credit(aw, 'Wording') }}</p>
  </section>
  {% endif %}

  {% if status_text %}
  <section class="band">
    {{ m.copy_status(status_text) }}
  </section>
  {% endif %}

  <div class="band">
    <dl class="facts">
      {% if record.claim.get('scope') %}
      <dt>Scope</dt>
      <dd>{{ record.claim.scope.value }} {{ m.attribution(record.claim.scope) }}</dd>
      {% endif %}
      {% if record.claim.get('exclusions') %}
      <dt>Excluded</dt>
      <dd>
        {% for ex in record.claim.exclusions %}
        <div>{{ ex.value }} {{ m.attribution(ex) }}</div>
        {% endfor %}
      </dd>
      {% endif %}
      <dt>Source</dt>
      <dd>
        {{ m.external_link(record.manuscript.url, record.manuscript.label) }}
        <span class="meta">
        {%- if record.manuscript.get('immutable_version_id') %} · {{ record.manuscript.immutable_version_id }}{% endif %} · retrieved {{ record.manuscript.retrieved_at }}</span>
        <div class="meta">{{ m.term('manuscript-hash', 'sha256', glossary, links) }} <code>{{ record.manuscript.sha256|short_hash }}</code></div>
        {% for artifact in record.manuscript.get('supplemental_artifacts', []) %}
        <div class="supplemental-artifact">
          Companion: {{ m.external_link(artifact.url, artifact.label) }}
          <span class="meta">· retrieved {{ artifact.retrieved_at }}</span>
          <div class="meta">{{ m.term('manuscript-hash', 'sha256', glossary, links) }} <code>{{ artifact.sha256|short_hash }}</code></div>
        </div>
        {% endfor %}
      </dd>
    </dl>
  </div>

  <section class="band">
    <p class="lbl">Evidence — {{ evidence|length }} {{ 'entry' if evidence|length == 1 else 'entries' }}</p>
    {% if evidence %}
    <ol class="ledger">
      {% for ev in evidence %}
      <li id="evidence-{{ ev.id }}" class="evidence-card evidence-{{ ev.kind }}">
        <div>
          <div class="evidence-head">
            <h3>{{ m.evidence_label(ev.kind) }}</h3>
            <span class="kind">{{ ev.id|short_hash }}{% if ev.kind == 'formal_artifact' %} · execution record attached{% elif ev.kind == 'mathematical_assessment' %} · focused on {{ ev.target }}{% endif %}</span>
          </div>

          {% if ev.kind == 'formal_artifact' %}
          <div class="side-by-side">
            <div class="informal">
              <h4>Statement in the paper</h4>
              <p>{{ record.claim.text.value }}</p>
            </div>
            <div class="formal">
              <h4>Statement represented in {{ ev.toolchain.get('name', '?') }}</h4>
              <p>{{ m.external_link(ev.repo) }} @ <code>{{ ev.commit|short_hash }}</code></p>
              <p>{{ ev.correspondence.value }}</p>
              <p class="meta">{{ m.attribution(ev.correspondence) }} · The match between statements is a human judgement, not an automated check.</p>
            </div>
          </div>
          <div class="rows">
            <div class="row"><span class="k">Allowed assumptions</span><span class="v">Standard classical Lean profile{% if ev.axiom_policy.get('allowlist') %} — {% for a in ev.axiom_policy.allowlist %}<code>{{ a }}</code>{{ ', ' if not loop.last }}{% endfor %}{% endif %}</span></div>
            {{ m.receipt_row('Code build', ev.artifact_build) }}
            {{ m.receipt_row('Assumption check', ev.axiom_policy.execution) }}
            <details class="technical-details"><summary>Technical execution details</summary>{{ m.runner_row(ev.artifact_build) }}</details>
          </div>

          {% elif ev.kind == 'external_formal_artifact' %}
          <p class="reported-note">Published by the source. Any independent rerun appears as a separate entry.</p>
          <p class="prose">{{ ev.description|readable_text }}</p>
          <p class="meta">{{ m.external_link(ev.repo) }}{% if ev.get('commit') %} @ <code>{{ ev.commit|short_hash }}</code>{% endif %} · {{ m.attribution(ev) }}</p>

          {% elif ev.kind == 'computational_reproduction' %}
          <p class="prose">{{ ev.description|readable_text }}</p>
          <div class="rows">
            {{ m.receipt_row('execution', ev.execution) }}
            {{ m.runner_row(ev.execution) }}
          </div>

          {% elif ev.kind == 'source_inspection' %}
          <p class="reported-note">Public-source and version check only. This is not a mathematical review.</p>
          <p class="prose">{{ ev.description|readable_text }}</p>
          <p class="meta">{{ m.attribution(ev) }}</p>

          {% elif ev.kind == 'informal_review' %}
          <p class="prose">{{ ev.text }}</p>
          <p class="meta">{{ m.attribution(ev) }}</p>

          {% elif ev.kind == 'mathematical_assessment' %}
          {% if ev.report.get('inline') %}<p class="prose">{{ ev.report.inline }}</p>{% endif %}
          {% if ev.report.get('url') %}<p class="meta">{{ m.external_link(ev.report.url) }}</p>{% endif %}
          <p class="meta">{{ m.attribution(ev) }}</p>
          {% if ev.get('author_response') %}
          <div class="author-response">
            <h4>Author response</h4>
            {% for r in ev.author_response %}
            <p>{{ r.text }} <span class="attribution">— {{ r.asserted_by }}, {{ r.asserted_at }}</span></p>
            {% endfor %}
          </div>
          {% endif %}
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="prose">No evidence entries recorded.</p>
    {% endif %}
  </section>

  {% if record.get('digestions') or record.get('importance_claims') %}
  {% set digestions = record.get('digestions', []) %}
  {% set plain_language = digestions|selectattr('kind', 'defined')|selectattr('kind', 'equalto', 'plain_language')|list %}
  {% set specialist = digestions|rejectattr('kind', 'defined')|list %}
  <section class="band">
    {# Plain-language explanations first, because the reader who needs one is
       the reader least likely to scroll past a paragraph written for a
       general mathematician. Each stratum is rendered as its own block with
       its own attribution: an author's explanation of their own result and an
       editor's explanation of it are different objects even when they agree,
       and merging them would produce an unsigned consensus nobody wrote. #}
    {% for d in plain_language %}
    <p class="lbl">Plain-language explanation</p>
    <p class="digestion-text plain-language">{{ d.text }}</p>
    <p class="meta">{{ m.credit(d, 'Explanation') }}</p>
    {% endfor %}
    {% for d in specialist %}
    <p class="lbl">Mathematical context</p>
    <p class="digestion-text">{{ d.text }}</p>
    {% endfor %}
    {% if record.get('importance_claims') %}
    <p class="lbl">Importance</p>
    {% for ic in record.importance_claims %}
    <p class="prose">{{ ic.text }} {{ m.attribution(ic) }}</p>
    {% endfor %}
    {% endif %}
  </section>
  {% endif %}

  <section class="band what-this-does-not-establish">
    <p class="lbl">Limits</p>
    <ul>
      <li>This record does not issue a whole-paper correctness judgement.</li>
      {% if formal_runs %}
      <li>Correspondence between formal and informal statements is attested, not machine-checked; a formalization may omit informal hypotheses.</li>
      <li>The formal adapter performs narrow artifact checks. It is not a general mathematical verifier.</li>
      {% endif %}
      {% if computational_runs %}<li>A reproduced computation establishes only the recorded execution result under the pinned inputs and environment.</li>{% endif %}
      {% if assessments or informal_reviews %}<li>Reviews and assessments are attributed conclusions by their writers, not conclusions issued by Significance.</li>{% endif %}
      {% if record.get('open_invitations') %}<li>Open invitations identify work not yet represented by a completed evidence entry.</li>{% endif %}
      {% if not formal_runs and not computational_runs and not assessments and not informal_reviews %}<li>No independent reproduction or mathematical assessment is represented unless an evidence entry above says otherwise.</li>{% endif %}
    </ul>
  </section>

</article>
{% endblock %}

{% block rail %}
<aside class="rail">

  <div class="band">
    <p class="lbl">Record details</p>
    <dl class="state-list">
      <div><dt>Publication state</dt><dd>{% if record.get('draft') %}Editorial draft{% elif record.record_state == 'active' %}Active record{% else %}{{ record.record_state|replace('_', ' ') }}{% endif %}</dd></div>
      <div><dt>Record version</dt><dd>{{ record.record_version }}</dd></div>
      <div><dt>Source check</dt><dd>{% if fr.get('result') == 'current' %}Current{% elif fr.get('result') == 'stale' %}Source changed{% else %}Not rechecked{% endif %}</dd></div>
      {% if fr.get('observed_source_version') %}
      <div><dt>Source version</dt><dd>{{ fr.observed_source_version }}</dd></div>
      {% endif %}
      <div><dt>Last checked</dt><dd>{{ fr.get('checked_at', '?')[:10] }}</dd></div>
    </dl>
  </div>

  {% if record.get('open_invitations') %}
  <div class="band" id="open-checks">
    <p class="lbl">Open checks — {{ record.open_invitations|selectattr('status', 'undefined')|list|length + record.open_invitations|selectattr('status', 'equalto', 'open')|list|length }}</p>
    <p class="lbl-sub">Each is a focused task.</p>
    <ul class="invitations">
      {% for oi in record.open_invitations %}
      <li>
        {% set oi_status = oi.get('status', 'open') %}
        <p class="meta">Status: {{ oi_status }}{% if oi_status == 'taken' %} · {{ oi.taken_by }} · {{ oi.taken_at[:10] }}{% if oi.taken_note %} · {{ oi.taken_note }}{% endif %}{% endif %}{% if oi_status == 'done' and oi.done_ref %} · <a href="#evidence-{{ oi.done_ref }}">Recorded result</a>{% endif %}</p>
        <p class="invitation-kind">{% if oi.kind == 'mathematical_review' %}Mathematical reading{% elif oi.kind == 'correspondence' %}Compare the statements{% elif oi.kind == 'reproduction' %}Rerun the artifact{% else %}{{ oi.kind|replace('_', ' ') }}{% endif %}</p>
        <p class="invitation-target">{% if oi_status in ('open', 'taken') %}<a href="{{ task_root }}{{ oi.task_id or ('task-' ~ loop.index) }}/index.html">{{ oi.target|short_hash }}</a>{% else %}{{ oi.target|short_hash }}{% endif %}</p>
        {# The affordance appears only where instructions exist. An invitation
           without `how` renders exactly as it did before this feature: a
           "take this task" control on a task with no instructions promises
           help that is not there, which is worse than the plain line it
           replaced. #}
        {% if oi.get('how') and oi_status == 'open' %}
        <div class="invitation-task">
          <p class="invitation-how-label">Take this task</p>
          <p class="invitation-how">{{ oi.how|readable_text }}</p>
          {% set respond = oi.get('respond') or {} %}
          {% set respond_url = respond.get('url')|safe_href %}
          {% set respond_mail = respond.get('mailto')|safe_email %}
          {% if respond_url or respond_mail %}
          <p class="invitation-respond">
            {% if respond_url %}<a href="{{ respond_url }}">Report what you found</a>{% endif %}
            {% if respond_url and respond_mail %} · {% endif %}
            {% if respond_mail %}<a href="mailto:{{ respond_mail }}?subject={{ ('Invitation response: ' ~ record.record_id)|urlencode }}">Report it by email</a>{% endif %}
          </p>
          {% endif %}
        </div>
        {% endif %}
        <p class="invitation-origin">Prepared by {{ m.party_label(oi.created_by) }} · {{ oi.created_at[:10] }}</p>
        {% if oi.get('_stale') %}<p class="meta">No update since {{ oi.taken_at[:10] }}.</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <section class="band" aria-labelledby="looked-heading">
    <p class="lbl" id="looked-heading">Who has looked at this</p>
    {% set named = [] %}
    {% for a in record.get('attestations', []) %}{% set _ = named.append(a) %}{% endfor %}
    {% for ev in evidence if ev.kind in ['informal_review', 'mathematical_assessment'] %}{% set _ = named.append(ev) %}{% endfor %}
    {% for oi in record.get('open_invitations', []) if oi.get('taken_by') %}{% set _ = named.append({'reviewer': oi.taken_by, 'scope': oi.target, 'stratum': ('machine' if record.get('parties', {}).get(oi.taken_by, {}).get('verification_method', {}).get('kind') == 'automation' else 'community'), 'asserted_at': oi.taken_at}) %}{% endfor %}
    {% if named %}<ul>{% for a in named %}<li><a href="{{ links.reviewers.rstrip('/')|replace('/index.html', '') }}/{{ (a.get('reviewer') or a.get('asserted_by')) }}/index.html">{{ m.party_label(a.get('reviewer') or a.get('asserted_by')) }}</a> · {{ a.get('scope', a.get('target', 'recorded work'))|short_hash }}{% if a.get('stratum') %} · {{ a.stratum }}{% endif %}{% if a.get('review_note') %}<p class="prose">{{ a.review_note }}</p>{% endif %}</li>{% endfor %}</ul>{% else %}<p class="prose">No named reviewer has recorded work on this claim yet.</p>{% endif %}
  </section>

  {% if record.get('depends_on') %}<section class="band"><p class="lbl">Builds on</p><ul>{% for d in record.depends_on %}<li>{% if d.record %}<a href="{{ links.records_index|replace('index.html', d.record ~ '/index.html') }}">{{ d.record }}</a>{% set upstream = record_lookup.get(d.record) %}{% if upstream and (upstream.record_state != 'active' or upstream.freshness.result in ['stale', 'unknown']) %} · depends on {{ d.record }}, currently {{ upstream.record_state }} / {{ upstream.freshness.result }}{% endif %}{% else %}<a href="{{ d.external.url|safe_href }}">{{ d.external.label }}</a>{% endif %} · {{ d.relation|replace('_', ' ') }}{% if d.note %} · {{ d.note }}{% endif %}</li>{% endfor %}</ul></section>{% endif %}
  {% if cited_by %}<section class="band"><p class="lbl">Cited by</p><ul>{% for r in cited_by %}<li><a href="{{ links.records_index|replace('index.html', r.record_id ~ '/index.html') }}">{{ r.claim.text.value }}</a></li>{% endfor %}</ul></section>{% endif %}

  {% set ai = record.get('ai_provenance') %}
  {% if ai %}
  <div class="band">
    <p class="lbl">Reported AI use</p>
    <p class="prose">{{ ai.disclosure.value }}</p>
    <p class="meta">{{ m.attribution(ai.disclosure) }}</p>
    {% if ai.get('roles') %}
    <ul class="roles">
      {% for r in ai.roles %}
      <li><span class="role">{{ m.role_label(r.role) }}</span><span class="role-meta"> — {{ r.model }} · {{ m.basis_label(r.basis) }} · {{ m.party_label(r.asserted_by) }}</span></li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endif %}

  <div class="band">
    <p class="lbl">History</p>
    <ul class="history">
      {% for h in record.get('history', [])|reverse %}
      <li>
        {% if h.get('note') %}<span class="history-note">{{ h.note }}</span>{% endif %}
        <span class="event-meta">{{ h.type|replace('_', ' ') }} · {{ h.at[:10] }} · {{ m.party_label(h.by) }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>

</aside>
{% endblock %}
