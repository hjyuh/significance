{% extends "base.html.jinja" %}
{% import "macros.jinja" as m %}

{% block title %}{{ record.record_id }} — Significance{% endblock %}
{% block shell_class %} with-rail{% endblock %}

{% set fr = record.get('freshness', {}) %}
{% set evidence = record.get('evidence', []) %}

{% block topline_meta %}RECORD {{ record.record_id }} / v{{ record.record_version }} / {{ record.record_state }} / freshness {{ fr.get('result', 'unknown') }}{% endblock %}

{% block content %}
<article class="record">

  {% set ps = record.get('plain_summary') %}
  {% if ps %}
  {# First content block on the page, above the formal dossier, because the
     reader this is for stops reading before they reach the ledger. It is
     styled calm on purpose: no banner, no colour, nothing that could be read
     as a status light. The label names the writer, because an unsigned plain
     summary would read as the site speaking. #}
  <section class="band plain-summary" aria-labelledby="plain-summary-heading">
    <p class="lbl" id="plain-summary-heading">
      Plain-language summary — written by {{ ps.asserted_by }}, not a verdict
    </p>
    <dl class="plain-summary-list">
      <div>
        <dt>What is claimed</dt>
        <dd>{{ ps.claimed }}</dd>
      </div>
      <div>
        <dt>What has been checked</dt>
        <dd>{{ ps.checked }}</dd>
      </div>
      <div>
        <dt>What has not been checked</dt>
        <dd>{{ ps.not_checked }}</dd>
      </div>
      <div>
        <dt>As of</dt>
        <dd>
          {{ fr.get('checked_at', '?') }}
          {%- if fr.get('result') %} · freshness {{ fr.result }}{% endif %}
        </dd>
      </div>
    </dl>
    <p class="meta">{{ m.attribution(ps) }} This block restates the record below in plainer words. It adds nothing to it.</p>
  </section>
  {% endif %}

  <div class="band claim-band">
    {% if fr.get('result') in ('stale', 'unknown') %}
    <div class="banner banner-{{ fr.result }}">
      <strong>Freshness: {{ fr.result|upper }}.</strong>
      {% if fr.get('observed_source_version') %}Observed source version {{ fr.observed_source_version }}, last confirmed {{ fr.confirmed_source_version }}.{% endif %}
      Checked at {{ fr.get('checked_at', '?') }}.
    </div>
    {% endif %}
    <p class="lbl">Claim / {{ record.claim.text.get('basis', '?') }} / {{ record.claim.text.get('asserted_by', '?') }}</p>
    <h1 class="claim-text">{{ record.claim.text.value }}</h1>
    <p>{{ m.attribution(record.claim.text) }}</p>
  </div>

  <div class="band">
    <dl class="facts">
      {% if record.claim.get('scope') %}
      <dt>Scope</dt>
      <dd>{{ record.claim.scope.value }} {{ m.attribution(record.claim.scope) }}</dd>
      {% endif %}
      {% if record.claim.get('exclusions') %}
      <dt>Excluded</dt>
      <dd>
        {% for ex in record.claim.exclusions %}
        <div>{{ ex.value }} {{ m.attribution(ex) }}</div>
        {% endfor %}
      </dd>
      {% endif %}
      <dt>Source</dt>
      <dd>
        {{ m.external_link(record.manuscript.url, record.manuscript.label) }}
        <span class="meta">
        {%- if record.manuscript.get('immutable_version_id') %} · {{ record.manuscript.immutable_version_id }}{% endif %} · retrieved {{ record.manuscript.retrieved_at }}</span>
        <div class="meta">sha256 <code>{{ record.manuscript.sha256 }}</code></div>
      </dd>
    </dl>
  </div>

  <section class="band">
    <p class="lbl">Evidence — {{ evidence|length }} {{ 'entry' if evidence|length == 1 else 'entries' }}</p>
    {% if evidence %}
    <ol class="ledger">
      {% for ev in evidence %}
      <li class="evidence-card evidence-{{ ev.kind }}">
        <div>
          <div class="evidence-head">
            <h3>{{ ev.id }}</h3>
            <span class="kind">{{ ev.kind }}{% if ev.kind == 'formal_artifact' %} · receipts attached{% elif ev.kind == 'external_formal_artifact' %} · no qualifying receipt{% elif ev.kind == 'mathematical_assessment' %} · target {{ ev.target }}{% endif %}</span>
          </div>

          {% if ev.kind == 'formal_artifact' %}
          <div class="side-by-side">
            <div class="informal">
              <h4>Informal — manuscript</h4>
              <p>{{ record.claim.text.value }}</p>
            </div>
            <div class="formal">
              <h4>Formal — {{ ev.toolchain.get('name', '?') }}</h4>
              <p>{{ m.external_link(ev.repo) }} @ <code>{{ ev.commit }}</code></p>
              <p>{{ ev.correspondence.value }}</p>
              <p>{{ m.attribution(ev.correspondence) }} Attested, not machine-checked.</p>
            </div>
          </div>
          <div class="rows">
            <div class="row"><span class="k">axiom policy</span><span class="v">{{ ev.axiom_policy.trust_profile }} (allowlist v{{ ev.axiom_policy.allowlist_version }}){% if ev.axiom_policy.get('allowlist') %} — {% for a in ev.axiom_policy.allowlist %}<code>{{ a }}</code>{{ ', ' if not loop.last }}{% endfor %}{% endif %}</span></div>
            {{ m.receipt_row('build', ev.artifact_build) }}
            {{ m.receipt_row('axiom closure', ev.axiom_policy.execution) }}
            {{ m.runner_row(ev.artifact_build) }}
          </div>

          {% elif ev.kind == 'external_formal_artifact' %}
          <p class="reported-note">Reported, not reproduced.</p>
          <p class="prose">{{ ev.description }}</p>
          <p class="meta">{{ m.external_link(ev.repo) }}{% if ev.get('commit') %} @ <code>{{ ev.commit }}</code>{% endif %} · {{ m.attribution(ev) }}</p>

          {% elif ev.kind == 'computational_reproduction' %}
          <p class="prose">{{ ev.description }}</p>
          <div class="rows">
            {{ m.receipt_row('execution', ev.execution) }}
            {{ m.runner_row(ev.execution) }}
          </div>

          {% elif ev.kind == 'informal_review' %}
          <p class="prose">{{ ev.text }}</p>
          <p class="meta">{{ m.attribution(ev) }}</p>

          {% elif ev.kind == 'mathematical_assessment' %}
          {% if ev.report.get('inline') %}<p class="prose">{{ ev.report.inline }}</p>{% endif %}
          {% if ev.report.get('url') %}<p class="meta">{{ m.external_link(ev.report.url) }}</p>{% endif %}
          <p class="meta">{{ m.attribution(ev) }}</p>
          {% if ev.get('author_response') %}
          <div class="author-response">
            <h4>Author response</h4>
            {% for r in ev.author_response %}
            <p>{{ r.text }} <span class="attribution">— {{ r.asserted_by }}, {{ r.asserted_at }}</span></p>
            {% endfor %}
          </div>
          {% endif %}
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="prose">No evidence entries recorded.</p>
    {% endif %}
  </section>

  {% if record.get('digestions') or record.get('importance_claims') %}
  {% set digestions = record.get('digestions', []) %}
  {% set plain_language = digestions|selectattr('kind', 'defined')|selectattr('kind', 'equalto', 'plain_language')|list %}
  {% set specialist = digestions|rejectattr('kind', 'defined')|list %}
  <section class="band">
    {# Plain-language explanations first, because the reader who needs one is
       the reader least likely to scroll past a paragraph written for a
       general mathematician. Each stratum is rendered as its own block with
       its own attribution: an author's explanation of their own result and an
       editor's explanation of it are different objects even when they agree,
       and merging them would produce an unsigned consensus nobody wrote. #}
    {% for d in plain_language %}
    <p class="lbl">What this result says — {{ d.stratum }} — {{ d.get('basis', '?') }} / {{ d.get('asserted_by', '?') }}</p>
    <p class="digestion-text plain-language">{{ d.text }}</p>
    <p class="meta">{{ m.attribution(d) }}</p>
    {% endfor %}
    {% for d in specialist %}
    <p class="lbl">Digestion — {{ d.audience }} — {{ d.get('basis', '?') }} / {{ d.get('asserted_by', '?') }}</p>
    <p class="digestion-text">{{ d.text }}</p>
    {% endfor %}
    {% if record.get('importance_claims') %}
    <p class="lbl">Importance</p>
    {% for ic in record.importance_claims %}
    <p class="prose">{{ ic.text }} {{ m.attribution(ic) }}</p>
    {% endfor %}
    {% endif %}
  </section>
  {% endif %}

  <section class="band what-this-does-not-establish">
    <p class="lbl">What this does not establish</p>
    <ul>
      <li>Correspondence between formal and informal statements is attested, not machine-checked.</li>
      <li>A formalization may omit hypotheses present in the informal statement.</li>
      <li>The adapter is not a general mathematical verifier — it performs narrow evidence checks.</li>
    </ul>
  </section>

</article>
{% endblock %}

{% block rail %}
<aside class="rail">

  <div class="band">
    <p class="lbl">State</p>
    <dl class="state-list">
      <div><dt>record_state</dt><dd>{{ record.record_state }}</dd></div>
      <div><dt>version</dt><dd>v{{ record.record_version }}</dd></div>
      <div><dt>freshness.result</dt><dd>{{ fr.get('result', 'unknown') }}</dd></div>
      {% if fr.get('observed_source_version') %}
      <div><dt>observed_version</dt><dd>{{ fr.observed_source_version }}</dd></div>
      {% endif %}
      {% if fr.get('confirmed_source_version') %}
      <div><dt>confirmed_version</dt><dd>{{ fr.confirmed_source_version }}</dd></div>
      {% endif %}
      <div><dt>checked_at</dt><dd>{{ fr.get('checked_at', '?') }}</dd></div>
    </dl>
  </div>

  {% if record.get('open_invitations') %}
  <div class="band">
    <p class="lbl">Open work — {{ record.open_invitations|length }}</p>
    <p class="lbl-sub">Bounded tasks another person can take.</p>
    <ul class="invitations">
      {% for oi in record.open_invitations %}
      <li>
        <p class="invitation-kind">{{ oi.kind|replace('_', ' ') }}</p>
        <p class="invitation-target">{{ oi.target }}</p>
        <p class="invitation-origin">{{ oi.created_by }} · {{ oi.created_at }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% set ai = record.get('ai_provenance') %}
  {% if ai %}
  <div class="band">
    <p class="lbl">AI provenance</p>
    <p class="prose">{{ ai.disclosure.value }}</p>
    <p class="meta">{{ m.attribution(ai.disclosure) }}</p>
    {% if ai.get('roles') %}
    <ul class="roles">
      {% for r in ai.roles %}
      <li><span class="role">{{ r.role|replace('_', ' ') }}</span><span class="role-meta"> — {{ r.model }} · {{ r.basis }} · {{ r.asserted_by }}</span></li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endif %}

  <div class="band">
    <p class="lbl">History — append-only</p>
    <ul class="history">
      {% for h in record.get('history', [])|reverse %}
      <li>
        <span class="event-id">{{ h.id }}</span>
        <span class="event-meta">{{ h.type }} · {{ h.at }} · {{ h.by }}{% if h.get('note') %}<br>{{ h.note }}{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </div>

</aside>
{% endblock %}
