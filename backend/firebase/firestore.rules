rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function moderator() {
      return verified() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }
    match /tasks/{task} {
      // The maintainer seeds the allowed task list; clients cannot invent tasks.
      allow read: if true;
      allow write: if false;
      match /comments/{comment} {
        allow read: if true;
        allow create: if verified()
          && exists(/databases/$(database)/documents/tasks/$(task))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'body', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/postLimits/$(request.auth.uid)).data.lastPosted == request.time
          && getAfter(/databases/$(database)/documents/postLimits/$(request.auth.uid)).data.lastComment == task + '/' + comment
          && (!exists(/databases/$(database)/documents/postLimits/$(request.auth.uid))
            || get(/databases/$(database)/documents/postLimits/$(request.auth.uid)).data.lastPosted < request.time - duration.value(30, 's'));
        allow update: if false;
        allow delete: if verified() && (resource.data.uid == request.auth.uid || moderator());
      }
    }
    match /postLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPosted', 'lastComment'])
        && request.resource.data.lastComment is string
        && request.resource.data.lastComment.size() <= 300
        && request.resource.data.lastPosted == request.time
        && (!exists(/databases/$(database)/documents/postLimits/$(uid))
          || resource.data.lastPosted < request.time - duration.value(30, 's'));
      allow delete: if false;
    }
    match /moderators/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
